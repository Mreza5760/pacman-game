{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: gcc.exe build active file",
            "type": "shell",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o", "${workspaceFolder}/build/${fileBasenameNoExtension}.exe"  // Ensure exe goes to 'build' folder
            ],
            "options": {
                "cwd": "${fileDirname}"  // Build in the directory of the active file
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "label": "Run Pacman",
            "type": "shell",
            "command": "${workspaceFolder}/build/${fileBasenameNoExtension}.exe",  // Ensure exe is executed from 'build'
            "options": {
                "cwd": "${workspaceFolder}"  // Set the working directory to the project root
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "dependsOn": ["C/C++: gcc.exe build active file"],  // Run this task after build
            "problemMatcher": []
        }
    ]
}
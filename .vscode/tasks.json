{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: gcc.exe build active file",
            "type": "shell",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o", "${workspaceFolder}/build/${fileBasenameNoExtension}.exe" 
            ],
            "options": {
                "cwd": "${fileDirname}"  
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "label": "Run Pacman",
            "type": "shell",
            "command": "${workspaceFolder}/build/${fileBasenameNoExtension}.exe",  
            "options": {
                "cwd": "${workspaceFolder}"  
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "dependsOn": ["C/C++: gcc.exe build active file"], 
            "problemMatcher": []
        }
    ]
}